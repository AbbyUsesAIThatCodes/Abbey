[configuration]
entry_symbol = "abbey_library_init"
compatibility_minimum = "4.4"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://bin/libabbey_native.so"
linux.release.x86_64 = "res://bin/libabbey_native.so"
windows.debug.x86_64 = "res://bin/abbey_native.dll"
windows.release.x86_64 = "res://bin/abbey_native.dll"
macos.debug = "res://bin/libabbey_native.dylib"
macos.release = "res://bin/libabbey_native.dylib"
